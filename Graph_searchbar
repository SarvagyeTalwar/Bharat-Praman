<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BHARAT PARAMAN</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
 
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-neutral-100 dark:bg-neutral-950 min-h-screen p-8 transition-colors">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    const FILTERS = [
      { id: 'all', label: 'All' },
      { id: 'nodes', label: 'Nodes' },
      { id: 'relations', label: 'Relations' },
    ];

    const MOCK_GRAPH_DATA = [
      { id: '1', label: 'Lok Sabha', subtitle: 'Connected to 543 nodes' },
      { id: '2', label: 'INC', subtitle: 'Conected to x nodes' },
      { id: '3', label: 'Consistuency', subtitle: 'Connected to x nodes' },
      { id: '4', label: 'Is Freedom Fighter',  subtitle: 'Connected to x nodes' },
      { id: '5', label: 'No of Terms' }
    ];

    function GraphSearchBar() {
      const [query, setQuery] = useState('');
      const [activeFilter, setActiveFilter] = useState('all');
      const [isOpen, setIsOpen] = useState(false);
      const [selectedIndex, setSelectedIndex] = useState(-1);
      const [isLoading, setIsLoading] = useState(false);
      const [selectedMessage, setSelectedMessage] = useState(null);
      const containerRef = useRef(null);

      // Filter suggestions based on query and category
      const filteredSuggestions = MOCK_GRAPH_DATA.filter(item => {
        const matchesQuery = item.label.toLowerCase().includes(query.toLowerCase()) || 
                             item.subtitle.toLowerCase().includes(query.toLowerCase());
        if (!matchesQuery) return false;
        if (activeFilter === 'nodes') return item.type === 'node' || item.type === 'concept';
        if (activeFilter === 'relations') return item.type === 'edge';
        return true;
      });

      useEffect(() => {
        const handleClickOutside = (e) => {
          if (containerRef.current && !containerRef.current.contains(e.target)) {
            setIsOpen(false);
          }
        };
        document.addEventListener('mousedown', handleClickOutside);
        return () => document.removeEventListener('mousedown', handleClickOutside);
      }, []);

      const handleKeyDown = (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setSelectedIndex(prev => (prev < filteredSuggestions.length - 1 ? prev + 1 : 0));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setSelectedIndex(prev => (prev > 0 ? prev - 1 : filteredSuggestions.length - 1));
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (selectedIndex >= 0 && filteredSuggestions[selectedIndex]) {
            handleSelect(filteredSuggestions[selectedIndex]);
          } else {
            handleSearch(query);
          }
        } else if (e.key === 'Escape') {
          setIsOpen(false);
        }
      };

      const handleSearch = (searchQuery) => {
        setIsOpen(false);
        setIsLoading(true);
        setSelectedMessage(`Searching graph database for: "${searchQuery}" [Filter: ${activeFilter}]`);
        setTimeout(() => setIsLoading(false), 600);
      };

      const handleSelect = (item) => {
        setQuery(item.label);
        setIsOpen(false);
        setSelectedMessage(`Selected: "${item.label}" (${item.type.toUpperCase()})`);
      };

      return (
        <div className="max-w-xl mx-auto mt-16 font-sans">
          <div className="text-center mb-6">
            <h1 className="text-5xl font-bold tracking-tight text-neutral-900 dark:text-white">Bharat Praman</h1>
            <p className="text-x text-neutral-500 mt-1">I have no strings </p>
          </div>

          <div ref={containerRef} className="relative">
            <div className="flex items-center bg-white dark:bg-black border border-neutral-300 dark:border-neutral-800 rounded-lg shadow-sm focus-within:border-black dark:focus-within:border-white transition-colors">
              <span className="pl-3.5 pr-2 text-neutral-400">
                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </span>

              <input
                type="text"
                value={query}
                onChange={(e) => {
                  setQuery(e.target.value);
                  setIsOpen(true);
                  setSelectedIndex(-1);
                }}
                onFocus={() => setIsOpen(true)}
                onKeyDown={handleKeyDown}
                placeholder="Search nodes, entities, or relations..."
                className="w-full py-2.5 text-sm bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 focus:outline-none"
              />

              {isLoading && (
                <div className="pr-3 text-neutral-400 animate-spin">
                  <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24">
                    <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="3" />
                    <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z" />
                  </svg>
                </div>
              )}

              {query && !isLoading && (
                <button
                  onClick={() => setQuery('')}
                  className="p-1 mr-2 text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200"
                >
                  ✕
                </button>
              )}

              <div className="flex items-center gap-1 pr-2 border-l border-neutral-200 dark:border-neutral-800 my-1 pl-2">
                {FILTERS.map(f => (
                  <button
                    key={f.id}
                    onClick={() => setActiveFilter(f.id)}
                    className={`px-2 py-0.5 text-xs rounded transition-colors ${
                      activeFilter === f.id
                        ? 'bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900'
                        : 'text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-300'
                    }`}
                  >
                    {f.label}
                  </button>
                ))}
              </div>
            </div>

            {isOpen && filteredSuggestions.length > 0 && (
              <div className="absolute z-50 left-0 right-0 mt-1 bg-white dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800 rounded-lg shadow-lg overflow-hidden">
                <ul className="max-h-60 overflow-y-auto py-1 divide-y divide-neutral-100 dark:divide-neutral-900">
                  {filteredSuggestions.map((item, index) => (
                    <li
                      key={item.id}
                      onMouseEnter={() => setSelectedIndex(index)}
                      onClick={() => handleSelect(item)}
                      className={`px-3 py-2 cursor-pointer flex items-center justify-between ${
                        selectedIndex === index ? 'bg-neutral-100 dark:bg-neutral-900' : 'hover:bg-neutral-50'
                      }`}
                    >
                      <div>
                        <div className="text-sm font-medium text-neutral-900 dark:text-neutral-100">{item.label}</div>
                        <div className="text-xs text-neutral-500">{item.subtitle}</div>
                      </div>
                      <span className="text-[10px] uppercase px-1.5 py-0.5 rounded border border-neutral-300 dark:border-neutral-700 text-neutral-600 dark:text-neutral-300 font-mono">
                        {item.type}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          {selectedMessage && (
            <div className="mt-6 p-3 border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-xs font-mono text-neutral-700 dark:text-neutral-300 rounded text-center">
              {selectedMessage}
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<GraphSearchBar />);
  </script>
</body>
</html>
