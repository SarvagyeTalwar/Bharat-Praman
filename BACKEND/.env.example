# Bharat Praman — environment template (repo root)
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

NEO4J_URI=neo4j+ssc://REPLACE_ME.databases.neo4j.io
NEO4J_USERNAME=REPLACE_ME
NEO4J_PASSWORD=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
LLM_MODEL=gemini-3.5-flash-lite
ANSWER_WITH_LLM=false
FRONTEND_ORIGIN=http://localhost:5500

# RTI Submission & Email Dispatch
# Recipient email where citizen RTI PDFs should be delivered:
RTI_ADMIN_EMAIL=your_email@example.com
# SMTP configuration (e.g. Gmail App Password, AWS SES, SendGrid, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_TLS=true
SMTP_FROM=no-reply@bharatpraman.org
