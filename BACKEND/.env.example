# Bharat Praman — backend secrets + RAG config
# Copy this to BACKEND/.env and fill in real values. NEVER commit BACKEND/.env.

# ---- Instance01: politician graph (MLAs, parties, cases, sections, ministries) ----
NEO4J_URI=neo4j+ssc://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- Instance02: ministry GraphRAG (Chunk / MHAChunk) ----
NEO4J_URI1=neo4j+ssc://yyyy.databases.neo4j.io
NEO4J_USERNAME1=neo4j
NEO4J_PASSWORD1=
NEO4J_DATABASE1=neo4j

# ---- LLMs (Gemini, AI Studio free tier) ----
# Text-to-Cypher (main.py) uses GEMINI_API_KEY + LLM_MODEL
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
ANSWER_WITH_LLM=1

# RAG answer generation (agent.py / mha_agent.py) uses GEMINI_API_KEY1 + LLM_MODEL1,
# falling back to GEMINI_API_KEY + LLM_MODEL if the "1" variants are empty.
GEMINI_API_KEY1=
LLM_MODEL1=gemini-3.5-flash-lite
